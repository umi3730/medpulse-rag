# ===========================================================================
# 知脉 MedPulse 环境配置
# 复制本文件为 .env 并修改：cp .env.example .env
# ===========================================================================

# --- Neo4j ---
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j

# Hugging Face model cache (kept on the project drive and ignored by Git)
HF_HOME=D:\medpulse-rag\data\huggingface
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_LOCAL_FILES_ONLY=true

# --- LLM 提供商 ---
# 可选: ollama | openai | anthropic
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=512

# --- OpenAI（LLM_PROVIDER=openai 时需要）---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=             # 留空则用官方地址，填写可兼容 DeepSeek 等兼容 API
# LLM_MODEL=gpt-4o             # 切换到 openai 时记得改模型名

# --- Anthropic（LLM_PROVIDER=anthropic 时需要）---
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-20250514

# --- 实体匹配 ---
# FUZZY_MATCH_THRESHOLD=80     # 模糊匹配阈值 0-100
